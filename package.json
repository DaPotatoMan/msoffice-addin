{
  "name": "msoffice-addin",
  "type": "module",
  "version": "0.0.8",
  "packageManager": "pnpm@10.34.6+sha512.7e1ae66a83a9143c118cc1944f37cc4f2b8acddeda4b001cfa78908f6e46e45e15292739ca6c9d026426cc757e9318cc98c5551d6a16c165097b0028ba87b4e6",
  "description": "Microsoft office addin module for Nuxt abd vite",
  "author": "Fahadul Islam @dapotatoman",
  "license": "MIT",
  "repository": "dapotatoman/msoffice-addin",
  "keywords": [
    "office-addin",
    "nuxt",
    "vite-plugin"
  ],
  "exports": {
    ".": {
      "types": "./dist/types.d.ts",
      "import": "./dist/module.mjs",
      "require": "./dist/module.cjs"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.mjs",
      "require": "./dist/vite.cjs"
    }
  },
  "main": "./dist/module.cjs",
  "types": "./dist/types.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "nuxt-module-build build",
    "dev": "nuxi dev playground",
    "dev:build": "nuxi build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxi prepare playground",
    "release": "npm run lint && npm run test && npm run prepack && changelogen --release && npm publish && git push --follow-tags",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@nuxt/kit": "^3.21.11",
    "fs-extra": "^11.4.1",
    "vite": "^7.2.6"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^2.27.3",
    "@nuxt/devtools": "latest",
    "@nuxt/eslint": "0.7.6",
    "@nuxt/module-builder": "^0.8.4",
    "@nuxt/schema": "^3.21.11",
    "@nuxt/test-utils": "^3.23.0",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.19.43",
    "changelogen": "^0.6.2",
    "eslint": "^8.57.1",
    "nuxt": "^3.11.1",
    "office-addin-manifest-converter": "^0.4.1",
    "office-addin-validator": "^1.0.5",
    "vitest": "^4.0.15"
  }
}

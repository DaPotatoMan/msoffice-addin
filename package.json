{
  "name": "msoffice-addin",
  "type": "module",
  "version": "0.0.8",
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1",
  "description": "Microsoft office addin module for Nuxt abd vite",
  "author": "Fahadul Islam @dapotatoman",
  "license": "MIT",
  "repository": "dapotatoman/msoffice-addin",
  "keywords": [
    "office-addin",
    "nuxt",
    "vite-plugin"
  ],
  "exports": {
    ".": {
      "types": "./dist/types.d.ts",
      "import": "./dist/module.mjs",
      "require": "./dist/module.cjs"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.mjs",
      "require": "./dist/vite.cjs"
    }
  },
  "main": "./dist/module.cjs",
  "types": "./dist/types.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "nuxt-module-build build",
    "dev": "nuxi dev playground",
    "dev:build": "nuxi build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxi prepare playground",
    "release": "npm run lint && npm run test && npm run prepack && changelogen --release && npm publish && git push --follow-tags",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@nuxt/kit": "^3.11.1",
    "fs-extra": "^11.2.0",
    "vite": "^7.2.6"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^2.11.6",
    "@nuxt/devtools": "latest",
    "@nuxt/eslint": "0.3.0-beta.7",
    "@nuxt/module-builder": "^0.5.5",
    "@nuxt/schema": "^3.11.1",
    "@nuxt/test-utils": "^3.12.0",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.12.2",
    "changelogen": "^0.5.5",
    "eslint": "^8.57.0",
    "nuxt": "^3.11.1",
    "office-addin-manifest-converter": "^0.2.4",
    "office-addin-validator": "^1.0.5",
    "vitest": "^4.0.15"
  }
}
